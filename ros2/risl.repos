    version: 7f86a05a8e2ba5266a2db91119b3ced6d720d2d9
  risl_simulation:
    type: git
    url: https://github.com/MaxlGao/RISL_simulation.git
    version: d659f7d4a3f79b26829d08cfe5b12f07a1b3806d
  risl_camera_localizer:
    type: git
    url: https://github.com/MaxlGao/RISL_camera_localizer.git
    version: 76b68e87b1ad69eec567c250b233eff94284f46a
  risl_camera_msgs:
